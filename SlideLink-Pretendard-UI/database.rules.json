{
 "rules": {
  ".read": false,
  ".write": false,
  "slidelink": {
   "$owner": {
    ".read": "auth != null && auth.uid === $owner",
    "$secret": {
     ".read": "auth != null && data.child('expires').val() > now",
     ".write": "auth != null && auth.uid === $owner",
     ".validate": "$secret.matches(/^[a-f0-9]{48}$/) && newData.hasChildren(['owner','expires','state','timer'])",
     "owner": {".validate":"newData.val() === $owner"},
     "expires": {".validate":"newData.isNumber() && ((!data.exists() && newData.val() > now && newData.val() <= now + 43260000) || (data.exists() && newData.val() === data.val()))"},
     "state": {
      ".validate":"newData.hasChildren(['seen','ready','black','pointer'])",
      "seen":{".validate":"newData.isNumber() && newData.val() <= now + 60000"},
      "ready":{".validate":"newData.isBoolean()"},
      "black":{".validate":"newData.isBoolean()"},
      "pointer":{".validate":"newData.isBoolean()"},
      "$other":{".validate":false}
     },
     "timer": {
      ".validate":"newData.hasChildren(['elapsed','started'])",
      "elapsed":{".validate":"newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000"},
      "started":{".validate":"newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"},
      "$other":{".validate":false}
     },
     "controller": {
      ".write":"auth != null && root.child('slidelink').child($owner).child($secret).child('expires').val() > now && newData.exists() && (!data.exists() || data.child('seen').val() < now - 15000 || (data.child('uid').val() === auth.uid && data.child('device').val() === newData.child('device').val()))",
      ".validate":"newData.hasChildren(['uid','device','seen']) && newData.child('uid').val() === auth.uid",
      "uid":{".validate":"newData.isString() && newData.val().length <= 128"},
      "device":{".validate":"newData.isString() && newData.val().matches(/^[a-zA-Z0-9-]{10,80}$/)"},
      "seen":{".validate":"newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"},
      "$other":{".validate":false}
     },
     "commands": {
      "$command": {
       ".write":"auth != null && !data.exists() && newData.exists() && root.child('slidelink').child($owner).child($secret).child('expires').val() > now && root.child('slidelink').child($owner).child($secret).child('controller/uid').val() === auth.uid && root.child('slidelink').child($owner).child($secret).child('controller/device').val() === newData.child('device').val() && root.child('slidelink').child($owner).child($secret).child('controller/seen').val() > now - 15000 && root.child('slidelink').child($owner).child($secret).child('state/ready').val() === true && root.child('slidelink').child($owner).child($secret).child('state/seen').val() > now - 12000",
       ".validate":"$command.matches(/^(0|[1-9][0-9]?)$/) && newData.hasChildren(['id','action','created','uid','device']) && (newData.child('action').val() !== 'move' || newData.hasChildren(['x','y'])) && (newData.child('action').val() !== 'scroll' || newData.hasChild('y'))",
       "id":{".validate":"newData.isNumber() && newData.val() >= now * 1000 - 60000000 && newData.val() <= now * 1000 + 60000000"},
       "action":{".validate":"newData.isString() && newData.val().matches(/^(next|prev|first|black|pointer|move|click|scroll|timer-toggle|timer-reset)$/)"},
       "created":{".validate":"newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"},
       "uid":{".validate":"newData.val() === auth.uid"},
       "device":{".validate":"newData.isString() && newData.val().matches(/^[a-zA-Z0-9-]{10,80}$/)"},
       "x":{".validate":"newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"},
       "y":{".validate":"newData.isNumber() && newData.val() >= -800 && newData.val() <= 800 && (newData.parent().child('action').val() !== 'move' || (newData.val() >= 0 && newData.val() <= 1))"},
       "$other":{".validate":false}
      }
     },
     "$other":{".validate":false}
    }
   }
  }
 }
}
